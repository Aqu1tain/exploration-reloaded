{
    "schemaVersion": 1,
    "id": "exploration-reloaded",
    "version": "${version}",
    "name": "Exploration Reloaded",
    "description": "Exploration maps, structure spacing tweaks, and wandering trader improvements extracted from Fixed Minecraft.",
    "authors": ["Aqu1tain"],
    "contributors": ["green_jab"],
    "contact": {
        "sources": "https://github.com/Aqu1tain/exploration-reloaded"
    },
    "license": "CC-BY-NC-SA-4.0",
    "environment": "*",
    "entrypoints": {
        "main": ["com.akitain.explorationreloaded.ExplorationReloaded"],
        "client": ["com.akitain.explorationreloaded.ExplorationReloadedClient"]
    },
    "mixins": [
        "exploration-reloaded.mixins.json",
        {
            "config": "exploration-reloaded.client.mixins.json",
            "environment": "client"
        }
    ],
    "accessWidener": "exploration-reloaded.accesswidener",
    "depends": {
        "fabricloader": ">=0.18.2",
        "minecraft": "1.21.11",
        "java": ">=17",
        "fabric-api": "*"
    }
}
